# Environment Variables for AgeWell+
# Copy this file to .env and fill in your Supabase credentials

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
# Legacy name used by this app (you can paste the new publishable key here)
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# Optional new naming alias (used if VITE_SUPABASE_ANON_KEY is empty)
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional: For local development with backend
VITE_API_URL=http://localhost:5001/api
